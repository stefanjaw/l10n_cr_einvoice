<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="forma_farmaceutica_view_form" model="ir.ui.view">
        <field name="name">forma.farmaceutica.view.form</field>
        <field name="model">forma.farmaceutica</field>
        <field name="arch" type="xml">
            <form string="">
             <sheet>
                <group>
                   <group>
                       <field name="code" required="True" />
                       <field name="name" required="True" />
                   </group>
                </group>
              </sheet>
            </form>
        </field>
    </record>
    
    <record id="forma_farmaceutica_view_tree" model="ir.ui.view">
      <field name="name">forma.farmaceutica.view.tree</field>
      <field name="model">forma.farmaceutica</field>
      <field name="arch" type="xml">
        <list string="">
          <field name="display_name" string="name"/>
        </list>
      </field>
    </record>
    
    <record id="forma_farmaceutica_view_search" model="ir.ui.view">
      <field name="name">forma.farmaceutica.view.search</field>
      <field name="model">forma.farmaceutica</field>
      <field name="arch" type="xml">
        <search string="">
              <field name="code" string="Código" filter_domain="[('code','ilike',self)]"/>
              <field name="name" string="Nombre" filter_domain="[('name','ilike',self)]"/>
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="forma_farmaceutica_action">
      <field name="name">Forma Farmaceutica</field>
      <field name="res_model">forma.farmaceutica</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="forma_farmaceutica_menu"
        name="Forma Farmaceutica"
        parent="stock.menu_stock_config_settings" action="forma_farmaceutica_action"
        sequence="0"
    />

</odoo>