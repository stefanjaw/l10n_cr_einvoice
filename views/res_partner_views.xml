<odoo>
<record id="l10n_cr_einvoice.res_partner_form_inherit" model="ir.ui.view">
  <field name="name">l10n_cr_einvoice.res.partner.form.inherit</field>
  <field name="model">res.partner</field>
  <field name="inherit_id" ref="base.view_partner_form"/>
  <field name="arch" type="xml">

    <xpath expr="//field[@name='vat']" position="before">
       <field name="fe_comercial_name"/>
       <field name="fe_identification_type" required="False"/>        
    </xpath>
    
    <xpath expr="//field[@name='vat']" position="after">
       <!-- <field name="fe_identificacion_extranjero"/> -->
        <field name="fe_otras_senas_extranjero"/>
       <!-- <field name="fe_fax_number"/> -->
    </xpath>
    
    <xpath expr="//page[@name='internal_notes']" position="after">
        <page string="Actividades Comerciales">
                  <group string="Actividades Comerciales">
                    <field name="fe_activity_code_ids">
                      <tree editable="1">
                        <field name="code" required="1"/>
                        <field name="description" required="1"/>
                      </tree>
                    </field>                              
                  </group>
        </page>
    </xpath>
      
  </field>
</record>
</odoo>
